pkgname=sora-agent
pkgver=0.4.0
pkgrel=1
pkgdesc='Model-agnostic agent runtime with human approval and quality gates'
arch=('any')
url='https://github.com/Mochi-Sora/SoraAgent'
license=('AGPL-3.0-only')
depends=(
    'python'
    'python-openai'
    'python-pypdf'
    'python-questionary'
    'python-rich'
    'python-typer'
)
optdepends=(
    'python-numpy: scientific helpers for execute_code'
    'python-requests: HTTP helpers for execute_code'
    'python-zstandard: zstd memory storage on Python < 3.14'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Mochi-Sora/SoraAgent/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('171d191bd0b9d1720723bf6b929cd51daf302ffde84d145c205c523b84ce45c4')

build() {
    cd "SoraAgent-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "SoraAgent-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
