pkgname=sora-desk
pkgver=0.2.3
pkgrel=1
pkgdesc='Native desktop client for the SoraAgent runtime'
arch=('x86_64')
url='https://github.com/Mochi-Sora/SoraDesk'
license=('AGPL-3.0-only')
depends=('gtk3' 'webkit2gtk-4.1')
optdepends=(
    'sora-agent: local agent runtime'
    'sora-desk-bridge: local bridge managed from Settings'
)
makedepends=('gcc' 'make' 'nodejs' 'npm' 'pkgconf' 'rust')
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/Mochi-Sora/SoraDesk/archive/refs/tags/v$pkgver.tar.gz"
)
sha256sums=('b3b6c9e3e76de7bcb8cbaf30d72af89b238b0894dec927b59044b80dc316f661')
install="$pkgname.install"

build() {
    cd "SoraDesk-$pkgver"
    npm ci --no-audit --no-fund
    # Use the Tauri CLI, not a bare `cargo build`: it sets up the production
    # frontendDist embedding instead of the devServer URL.
    npm run tauri -- build --no-bundle --ci
}

check() {
    cd "SoraDesk-$pkgver"
    npm run check-versions
    npm run smoke
}

package() {
    cd "SoraDesk-$pkgver"
    install -Dm755 src-tauri/target/release/soradesk "$pkgdir/usr/bin/soradesk"
    install -Dm644 src-tauri/icons/32x32.png \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/soradesk.png"
    install -Dm644 src-tauri/icons/128x128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/soradesk.png"
    install -Dm644 src-tauri/icons/128x128@2x.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/soradesk.png"
    install -Dm644 "$startdir/files/SoraDesk.desktop" \
        "$pkgdir/usr/share/applications/SoraDesk.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
