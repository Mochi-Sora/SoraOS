pkgname=soraos-release
pkgver=0.1.0
pkgrel=1
pkgdesc='SoraOS release identity, defaults, and pacman repository wiring'
arch=('any')
url='https://github.com/Mochi-Sora/SoraOS'
license=('AGPL-3.0-only')
depends=('bash' 'coreutils' 'filesystem' 'grep' 'pacman' 'soraos-keyring' 'soraos-mirrorlist')
install=soraos-release.install

package() {
    install -Dm644 "$startdir/files/usr/share/soraos/os-release" "$pkgdir/usr/share/soraos/os-release"
    install -Dm644 "$startdir/files/usr/share/soraos/issue" "$pkgdir/usr/share/soraos/issue"
    install -Dm644 "$startdir/files/usr/share/soraos/lsb-release" "$pkgdir/usr/share/soraos/lsb-release"
    install -Dm755 "$startdir/files/usr/lib/soraos/write-release" "$pkgdir/usr/lib/soraos/write-release"
    install -Dm755 "$startdir/files/usr/lib/soraos/add-repo" "$pkgdir/usr/lib/soraos/add-repo"
    install -Dm644 "$startdir/files/usr/share/libalpm/hooks/soraos-release.hook" "$pkgdir/usr/share/libalpm/hooks/soraos-release.hook"
    install -Dm644 "$startdir/files/usr/share/libalpm/hooks/soraos-repo.hook" "$pkgdir/usr/share/libalpm/hooks/soraos-repo.hook"
    install -Dm644 "$startdir/files/etc/locale.conf" "$pkgdir/etc/locale.conf"
    install -Dm644 "$startdir/files/etc/vconsole.conf" "$pkgdir/etc/vconsole.conf"
}
