pkgname=soraos-keyring
pkgver=0.1.0
pkgrel=1
pkgdesc='SoraOS repository signing keyring'
arch=('any')
url='https://github.com/Mochi-Sora/SoraOS'
license=('AGPL-3.0-only')
depends=('gnupg' 'pacman')
options=('!strip')

package() {
    install -Dm644 "$startdir/files/usr/share/pacman/keyrings/soraos.gpg" "$pkgdir/usr/share/pacman/keyrings/soraos.gpg"
    install -Dm644 "$startdir/files/usr/share/pacman/keyrings/soraos-trusted" "$pkgdir/usr/share/pacman/keyrings/soraos-trusted"
    install -Dm644 "$startdir/files/usr/share/pacman/keyrings/soraos-revoked" "$pkgdir/usr/share/pacman/keyrings/soraos-revoked"
}
